# Copy to backend/.env for local development. NEVER commit a real .env file.

ENVIRONMENT=development            # development | production
DATABASE_URL=sqlite:///./boltitoli.db
# Production example (database must use UTF8 encoding for Devanagari):
# DATABASE_URL=postgresql+psycopg://boltitoli:CHANGE_ME@db:5432/boltitoli
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
LOG_LEVEL=INFO

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-dev-only-change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
REFRESH_COOKIE_SECURE=false        # true in production (HTTPS)
REFRESH_COOKIE_SAMESITE=lax        # use "none" (with SECURE=true) if frontend and API are on different sites

# --- Claude (optional) — summaries, explanations, drafting questions ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_SUMMARY=claude-sonnet-5-5
ANTHROPIC_MODEL_FEEDBACK=claude-haiku-5-5

# --- Sarvam (optional) — Hindi speech recognition and speech ---
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya
SARVAM_TTS_PACE=0.9
TTS_CACHE_DIR=./.cache/tts

# --- Product ---
DEMO_MODE_ENABLED=true             # set false in production unless you want the public demo school
DATA_RETENTION_DAYS=730
RATE_LIMIT_ENABLED=true
